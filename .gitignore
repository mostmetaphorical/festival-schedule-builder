# Secrets — never commit these.
tmdb_key.txt
.env

# Working data and generated output. Note the leading slash: app/data/ holds
# the files the published app actually needs, and must stay in the repo.
/data/
results/
__pycache__/
*.pyc
.venv/

# MovieLens is licensed for research use and may not be redistributed, so the
# dataset and anything derived from it stays out of the repo. Rebuild it with
# the scripts in the README.
app/fixtures/sample-ratings.csv

# Other people's rating histories are theirs. Keep exports out of the repo.
exports/
# Bug reports can carry the sender's email address.
reports/
*-ratings.csv
!app/fixtures/demo-ratings.csv

# Festival pages and data files saved by hand from a festival's site, before
# conversion. Kept locally; only the converted festival file is published.
/raw/

# Personal exports used for local testing
app/fixtures/private-*

# Scratch commit messages.
.commit-msg

# Cloudflare Worker local state and secrets.
worker/.dev.vars
worker/.wrangler/
.wrangler/
node_modules/

# Volunteer shifts, work hours, appointments: personal data that says where
# somebody will be at a given hour. Never publish these.
app/data/my-commitments.json
my-commitments.json
